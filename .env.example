# Copy this file to .env and fill in values before running setup.
# Never commit .env to version control.

# Required — set a random string (e.g. openssl rand -hex 32)
WEBUI_SECRET_KEY=change_me_to_a_random_string

# Anthropic — Claude subscription API key
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# LiteLLM (Step 2) — internal auth key between Open WebUI and LiteLLM
# Can be any string for local use
# LITELLM_MASTER_KEY=sk-local

# NVIDIA NIM (Step 3)
# Get your key at https://build.nvidia.com
# NGC_API_KEY=
