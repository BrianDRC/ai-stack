# Copy this file to .env and fill in values before running setup.
# Never commit .env to version control.

# Required — set a random string (e.g. openssl rand -hex 32)
WEBUI_SECRET_KEY=change_me_to_a_random_string

# Anthropic — Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# LiteLLM — internal auth key between Open WebUI and LiteLLM
# Any string works for local use
LITELLM_MASTER_KEY=sk-local

# NVIDIA NIM (Step 4) — NGC API key (https://build.nvidia.com)
# NGC_API_KEY=
